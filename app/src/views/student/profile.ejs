<%- include('../layouts/header') %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
        <div class="position-relative d-inline-block mx-auto mb-3">
          <img src="<%= user.avatar %>" alt="avatar" class="rounded-circle shadow-sm" width="100" height="100" style="object-fit: cover;">
          <span class="position-absolute bottom-0 end-0 badge rounded-pill <%= user.role === 'admin' ? 'bg-danger' : 'bg-primary' %>">
            <%= user.role %>
          </span>
        </div>
        <h3 class="fw-bold text-dark mb-1"><%= user.full_name %></h3>
        <p class="text-muted small mb-3">@<%= user.username %> • <%= user.email %></p>

        <div class="row g-2 text-start border-top border-bottom py-3 my-3">
          <div class="col-6">
            <span class="text-muted small d-block">Vai trò trong hệ thống:</span>
            <span class="fw-semibold text-dark"><%= user.role === 'admin' ? 'Quản Trị Viên (Admin)' : 'Học Viên (Student)' %></span>
          </div>
          <div class="col-6">
            <span class="text-muted small d-block">Số khóa học đã đăng ký:</span>
            <span class="fw-semibold text-primary"><%= enrolledCount %> khóa</span>
          </div>
          <div class="col-12 mt-2">
            <span class="text-muted small d-block">Ngày tham gia hệ thống:</span>
            <span class="fw-semibold text-dark"><%= new Date(user.created_at).toLocaleString('vi-VN') %></span>
          </div>
        </div>

        <div class="d-flex justify-content-center gap-2">
          <% if (user.role === 'student') { %>
            <a href="/student/my-courses" class="btn btn-primary btn-sm px-4">
              <i class="bi bi-journal-check me-1"></i> Khóa học của tôi
            </a>
          <% } else { %>
            <a href="/admin/dashboard" class="btn btn-warning btn-sm px-4 text-dark fw-bold">
              <i class="bi bi-speedometer2 me-1"></i> Bảng điều khiển Quản trị
            </a>
          <% } %>
          <a href="/auth/logout" class="btn btn-outline-danger btn-sm px-4">
            <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
