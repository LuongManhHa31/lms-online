<%- include('../layouts/header') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold text-dark mb-1">Khóa Học Của Tôi</h2>
      <p class="text-muted small mb-0">Theo dõi tiến độ học tập và tiếp tục các bài giảng đã đăng ký</p>
    </div>
    <a href="/courses" class="btn btn-outline-primary btn-sm px-3">
      <i class="bi bi-plus-circle me-1"></i> Khám phá thêm khóa học
    </a>
  </div>

  <% if (welcome) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-stars me-2"></i> Chào mừng bạn gia nhập LMS! Bạn có thể bắt đầu đăng ký các khóa học ngay bây giờ.
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="row g-4">
    <% if (courses && courses.length > 0) { %>
      <% courses.forEach(c => { %>
        <% 
          const total = c.total_lessons || 0;
          const done = c.completed_lessons || 0;
          const percent = total > 0 ? Math.round((done / total) * 100) : 0;
        %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 course-card shadow-sm bg-white">
            <img src="<%= c.thumbnail_url %>" class="card-img-top course-thumbnail" alt="<%= c.title %>" onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600'">
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-light text-primary border"><%= c.category_name || 'Khóa học' %></span>
                <% if (c.enrollment_status === 'pending') { %>
                  <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Chờ Duyệt</span>
                <% } else if (c.enrollment_status === 'rejected') { %>
                  <span class="badge bg-danger-subtle text-danger"><i class="bi bi-x-circle me-1"></i> Bị Từ Chối</span>
                <% } else if (c.enrollment_status === 'completed' || percent === 100) { %>
                  <span class="badge bg-info-subtle text-info"><i class="bi bi-award-fill me-1"></i> Hoàn Thành</span>
                <% } else { %>
                  <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle-fill me-1"></i> Đang Học</span>
                <% } %>
              </div>

              <h5 class="card-title fw-bold text-dark mb-2">
                <a href="/courses/<%= c.id %>" class="text-dark text-decoration-none"><%= c.title %></a>
              </h5>
              
              <!-- Tiến độ học tập -->
              <% if (c.enrollment_status === 'pending') { %>
                <div class="my-3 p-3 bg-light rounded-3 text-center">
                  <small class="text-muted"><i class="bi bi-info-circle me-1"></i> Đang chờ Quản trị viên duyệt để mở bài học</small>
                </div>
              <% } else { %>
                <div class="my-3">
                  <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Tiến độ học:</span>
                    <span class="fw-semibold text-primary"><%= percent %>% (<%= done %>/<%= total %> bài)</span>
                  </div>
                  <div class="progress">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: <%= percent %>%"></div>
                  </div>
                </div>
              <% } %>

              <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                <small class="text-muted"><i class="bi bi-calendar-check me-1"></i> <%= new Date(c.enrolled_at).toLocaleDateString('vi-VN') %></small>
                <% if (c.enrollment_status === 'pending') { %>
                  <a href="/courses/<%= c.id %>" class="btn btn-outline-secondary btn-sm px-3">
                    Xem Khóa Học
                  </a>
                <% } else { %>
                  <a href="/courses/<%= c.id %>" class="btn btn-primary btn-sm px-3 fw-semibold">
                    <%= percent === 100 ? 'Ôn tập lại' : 'Vào học tiếp' %> <i class="bi bi-arrow-right ms-1"></i>
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12 text-center py-5">
        <div class="card border-0 shadow-sm p-5 bg-white rounded-4">
          <div class="text-muted mb-3"><i class="bi bi-mortarboard fs-1 text-primary"></i></div>
          <h4 class="fw-bold text-dark">Bạn chưa đăng ký khóa học nào</h4>
          <p class="text-muted mb-4">Hãy tham khảo kho khóa học phong phú và đăng ký để bắt đầu trải nghiệm học tập ngay!</p>
          <div>
            <a href="/courses" class="btn btn-primary px-4 py-2">
              <i class="bi bi-compass me-1"></i> Duyệt danh sách khóa học
            </a>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('../layouts/footer') %>
