<%- include('../layouts/header') %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h3 class="fw-bold text-dark mb-1"><%= course ? 'Chỉnh Sửa Khóa Học' : 'Thêm Khóa Học Mới' %></h3>
            <p class="text-muted small mb-0"><%= course ? `Cập nhật thông tin cho khóa học: ${course.title}` : 'Điền thông tin để tạo khóa học mới trên hệ thống' %></p>
          </div>
          <a href="/admin/courses" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
          </a>
        </div>

        <form action="<%= action %>" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Tên khóa học *</label>
            <input type="text" name="title" class="form-control" placeholder="Ví dụ: Lập trình Microservices với Docker" value="<%= course ? course.title : '' %>" required>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Danh mục *</label>
              <select name="category_id" class="form-select" required>
                <option value="">-- Chọn danh mục --</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>" <%= (course && course.category_id === cat.id) ? 'selected' : '' %>>
                    <%= cat.name %>
                  </option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Giảng viên phụ trách</label>
              <input type="text" name="instructor" class="form-control" placeholder="Tên giảng viên / Trung tâm" value="<%= course ? course.instructor : '' %>">
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Cấp độ</label>
              <select name="level" class="form-select">
                <option value="Cơ bản" <%= (course && course.level === 'Cơ bản') ? 'selected' : '' %>>Cơ bản</option>
                <option value="Trung cấp" <%= (course && course.level === 'Trung cấp') ? 'selected' : '' %>>Trung cấp</option>
                <option value="Nâng cao" <%= (course && course.level === 'Nâng cao') ? 'selected' : '' %>>Nâng cao</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Học phí (VNĐ)</label>
              <input type="number" name="price" class="form-control" placeholder="0" value="<%= course ? course.price : 0 %>">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Link ảnh Thumbnail (URL)</label>
            <input type="url" name="thumbnail_url" class="form-control" placeholder="https://example.com/image.jpg" value="<%= course ? course.thumbnail_url : 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600' %>">
            <small class="text-muted">Nhập đường link ảnh đại diện khóa học (hỗ trợ ảnh Unsplash hoặc trực tuyến)</small>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-semibold">Mô tả chi tiết khóa học *</label>
            <textarea name="description" class="form-control" rows="5" placeholder="Mô tả nội dung, mục tiêu đầu ra và đối tượng học viên..." required><%= course ? course.description : '' %></textarea>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a href="/admin/courses" class="btn btn-light px-4">Hủy</a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
              <i class="bi bi-save me-1"></i> <%= course ? 'Lưu Thay Đổi' : 'Tạo Khóa Học' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
