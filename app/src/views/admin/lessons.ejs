<%- include('../layouts/header') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <span class="badge bg-primary mb-1">Khóa học: <%= course.title %></span>
      <h2 class="fw-bold text-dark mb-0">Quản Lý Giáo Trình Bài Học</h2>
      <p class="text-muted small mb-0">Thêm bài học mới, sắp xếp thứ tự và nội dung bài giảng video</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/courses" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại Khóa học
      </a>
      <a href="/admin/courses/<%= course.id %>/lessons/new" class="btn btn-success btn-sm px-3 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Thêm Bài Học Mới
      </a>
    </div>
  </div>

  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="text-center" style="width: 70px;">Số thứ tự</th>
            <th>Tiêu đề bài học</th>
            <th>Thời lượng</th>
            <th>Video Embed</th>
            <th>Ngày tạo</th>
            <th class="text-end" style="width: 150px;">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% if (lessons && lessons.length > 0) { %>
            <% lessons.forEach(l => { %>
              <tr>
                <td class="text-center">
                  <span class="badge bg-secondary rounded-pill"><%= l.order_num %></span>
                </td>
                <td>
                  <h6 class="mb-0 fw-bold text-dark"><%= l.title %></h6>
                  <small class="text-muted">ID: #<%= l.id %></small>
                </td>
                <td>
                  <span class="text-muted small"><i class="bi bi-clock me-1"></i><%= l.duration_minutes %> phút</span>
                </td>
                <td>
                  <% if (l.video_url) { %>
                    <span class="badge bg-success-subtle text-success small"><i class="bi bi-youtube me-1"></i> Có Video</span>
                  <% } else { %>
                    <span class="badge bg-light text-muted border small">Chỉ có tài liệu</span>
                  <% } %>
                </td>
                <td class="small text-muted"><%= new Date(l.created_at).toLocaleDateString('vi-VN') %></td>
                <td class="text-end">
                  <div class="d-inline-flex gap-1">
                    <a href="/lessons/<%= l.id %>" target="_blank" class="btn btn-outline-info btn-sm" title="Xem trước bài học">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="/admin/lessons/<%= l.id %>/edit" class="btn btn-outline-secondary btn-sm" title="Sửa bài học">
                      <i class="bi bi-pencil-square"></i>
                    </a>
                    <form action="/admin/lessons/<%= l.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài học này?');">
                      <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa bài học">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-5">
                <i class="bi bi-file-earmark-x fs-2 d-block mb-2"></i>
                Chưa có bài học nào trong khóa học này. Hãy nhấn <strong>Thêm Bài Học Mới</strong> để tạo nội dung.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
