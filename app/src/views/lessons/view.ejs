<%- include('../layouts/header') %>

<div class="container-fluid px-lg-5 py-3">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
      <li class="breadcrumb-item"><a href="/courses">Khóa học</a></li>
      <li class="breadcrumb-item"><a href="/courses/<%= lesson.course_id %>"><%= lesson.course_title %></a></li>
      <li class="breadcrumb-item active"><%= lesson.title %></li>
    </ol>
  </nav>

  <div class="row g-4">
    <!-- Cột chính: Video & Nội dung bài học -->
    <div class="col-lg-8 col-xl-9">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <!-- Khung Video nếu có video_url -->
        <% if (lesson.video_url) { %>
          <div class="video-responsive mb-4 shadow-sm">
            <iframe 
              src="<%= lesson.video_url %>" 
              title="<%= lesson.title %>" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen>
            </iframe>
          </div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-3 mb-3 border-bottom">
          <div>
            <span class="badge bg-primary mb-1">Bài số <%= lesson.order_num %></span>
            <h3 class="fw-bold text-dark mb-0"><%= lesson.title %></h3>
          </div>
          <div class="d-flex align-items-center gap-2">
            <!-- Form Đánh dấu hoàn thành -->
            <form action="/lessons/<%= lesson.id %>/complete" method="POST" class="d-inline">
              <% if (nextLesson) { %>
                <input type="hidden" name="next_id" value="<%= nextLesson.id %>">
              <% } %>
              <% if (isCompleted) { %>
                <button type="submit" class="btn btn-outline-success btn-sm">
                  <i class="bi bi-check-circle-fill me-1"></i> Đã hoàn thành (Bấm để hủy)
                </button>
              <% } else { %>
                <button type="submit" class="btn btn-success btn-sm px-3 shadow-sm">
                  <i class="bi bi-check-lg me-1"></i> Đánh dấu hoàn thành <%= nextLesson ? '& sang bài tiếp' : '' %>
                </button>
              <% } %>
            </form>
          </div>
        </div>

        <!-- Chi tiết nội dung văn bản bài học -->
        <div class="lesson-body text-dark py-2" style="font-size: 1.05rem; line-height: 1.8;">
          <%- lesson.content %>
        </div>

        <!-- Thanh điều hướng Trước / Sau -->
        <div class="border-top pt-4 mt-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <% if (prevLesson) { %>
            <a href="/lessons/<%= prevLesson.id %>" class="btn btn-outline-secondary">
              <i class="bi bi-arrow-left me-1"></i> Bài trước: <%= prevLesson.title %>
            </a>
          <% } else { %>
            <div></div>
          <% } %>

          <% if (nextLesson) { %>
            <a href="/lessons/<%= nextLesson.id %>" class="btn btn-primary px-4">
              Bài tiếp theo: <%= nextLesson.title %> <i class="bi bi-arrow-right ms-1"></i>
            </a>
          <% } else { %>
            <a href="/courses/<%= lesson.course_id %>" class="btn btn-success px-4">
              <i class="bi bi-check-all me-1"></i> Hoàn thành toàn bộ khóa học
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Cột phụ: Danh sách bài học của khóa học (Sidebar Navigation) -->
    <div class="col-lg-4 col-xl-3">
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white sticky-top" style="top: 80px;">
        <div class="card-header bg-dark text-white py-3">
          <h6 class="mb-0 fw-bold d-flex justify-content-between align-items-center">
            <span><i class="bi bi-collection-play me-2"></i> Nội dung khóa học</span>
            <span class="badge bg-secondary"><%= completedIds.length %>/<%= allLessons.length %></span>
          </h6>
          <small class="text-light opacity-75 text-truncate d-block mt-1"><%= lesson.course_title %></small>
        </div>

        <div class="list-group list-group-flush lesson-list-group" style="max-height: calc(100vh - 220px); overflow-y: auto;">
          <% allLessons.forEach((item, index) => { %>
            <% const activeClass = item.id === lesson.id ? 'active' : ''; %>
            <% const itemDone = completedIds.includes(item.id); %>
            <a href="/lessons/<%= item.id %>" class="list-group-item list-group-item-action py-3 <%= activeClass %>">
              <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 text-truncate">
                  <% if (itemDone) { %>
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                  <% } else if (item.id === lesson.id) { %>
                    <i class="bi bi-play-circle-fill text-primary fs-5"></i>
                  <% } else { %>
                    <i class="bi bi-circle text-muted fs-6"></i>
                  <% } %>
                  <span class="small text-truncate"><%= item.order_num %>. <%= item.title %></span>
                </div>
                <small class="text-muted ms-2"><%= item.duration_minutes %>p</small>
              </div>
            </a>
          <% }) %>
        </div>

        <div class="card-footer bg-light p-3 text-center">
          <a href="/courses/<%= lesson.course_id %>" class="small text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Quay lại trang thông tin khóa học
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
