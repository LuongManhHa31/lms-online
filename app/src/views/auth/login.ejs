<%- include('../layouts/header') %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="text-center mb-4">
          <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex p-3 mb-2">
            <i class="bi bi-box-arrow-in-right fs-2"></i>
          </div>
          <h3 class="fw-bold text-dark">Đăng Nhập LMS</h3>
          <p class="text-muted small">Nhập thông tin tài khoản của bạn để tiếp tục</p>
        </div>

        <% if (error) { %>
          <div class="alert alert-danger py-2 small d-flex align-items-center">
            <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <% if (success) { %>
          <div class="alert alert-success py-2 small d-flex align-items-center">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div><%= success %></div>
          </div>
        <% } %>

        <form action="/auth/login" method="POST" id="loginForm">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Tên đăng nhập hoặc Email</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
              <input type="text" name="username" id="usernameInput" class="form-control" placeholder="admin hoặc student" required autofocus>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-semibold">Mật khẩu</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
              <input type="password" name="password" id="passwordInput" class="form-control" placeholder="••••••••" required>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold mb-3">
            Đăng nhập
          </button>
        </form>

        <div class="text-center mb-3">
          <span class="text-muted small">Chưa có tài khoản? </span>
          <a href="/auth/register" class="small fw-semibold text-decoration-none">Đăng ký ngay</a>
        </div>

        <!-- Hộp tài khoản mẫu để kiểm thử nhanh -->
        <div class="border rounded-3 p-3 bg-light">
          <h6 class="fw-bold small text-dark mb-2"><i class="bi bi-info-circle-fill text-primary me-1"></i> Tài khoản thử nghiệm (Đề 17):</h6>
          <div class="d-flex flex-column gap-2">
            <button type="button" class="btn btn-sm btn-outline-danger text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('admin', 'admin123')">
              <span><strong>Admin:</strong> admin / admin123</span>
              <span class="badge bg-danger">Chọn</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary text-start d-flex justify-content-between align-items-center" onclick="fillCredentials('student', 'student123')">
              <span><strong>Học viên:</strong> student / student123</span>
              <span class="badge bg-primary">Chọn</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function fillCredentials(user, pass) {
  document.getElementById('usernameInput').value = user;
  document.getElementById('passwordInput').value = pass;
}
</script>

<%- include('../layouts/footer') %>
