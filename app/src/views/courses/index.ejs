<%- include('../layouts/header') %>

<div class="container py-4">
  <!-- Tiêu đề trang & Thanh tìm kiếm -->
  <div class="row align-items-center mb-4">
    <div class="col-md-6 mb-3 mb-md-0">
      <h2 class="fw-bold text-dark mb-1">Thư Viện Khóa Học</h2>
      <p class="text-muted small mb-0">Tìm kiếm khóa học phù hợp với định hướng phát triển của bạn</p>
    </div>
    <div class="col-md-6">
      <form action="/courses" method="GET" class="d-flex gap-2">
        <div class="input-group">
          <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
          <input type="text" name="q" class="form-control" placeholder="Tìm theo tên khóa học, giảng viên..." value="<%= searchQuery %>">
        </div>
        <button type="submit" class="btn btn-primary px-3">Tìm</button>
        <% if (searchQuery || selectedCategory !== 'all') { %>
          <a href="/courses" class="btn btn-outline-secondary" title="Đặt lại bộ lọc"><i class="bi bi-x-lg"></i></a>
        <% } %>
      </form>
    </div>
  </div>

  <!-- Bộ lọc danh mục (Category filter pills) -->
  <div class="d-flex gap-2 flex-wrap mb-4 pb-2 border-bottom">
    <a href="/courses<%= searchQuery ? '?q=' + encodeURIComponent(searchQuery) : '' %>" 
       class="btn btn-sm <%= selectedCategory === 'all' ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3">
      Tất cả danh mục
    </a>
    <% categories.forEach(cat => { %>
      <a href="/courses?category=<%= cat.id %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" 
         class="btn btn-sm <%= String(selectedCategory) === String(cat.id) ? 'btn-primary' : 'btn-outline-secondary' %> rounded-pill px-3">
        <i class="bi <%= cat.icon || 'bi-bookmark' %> me-1"></i><%= cat.name %>
      </a>
    <% }) %>
  </div>

  <!-- Danh sách lưới khóa học -->
  <div class="row g-4">
    <% if (courses && courses.length > 0) { %>
      <% courses.forEach(c => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 course-card shadow-sm bg-white">
            <div class="position-relative">
              <img src="<%= c.thumbnail_url %>" class="card-img-top course-thumbnail" alt="<%= c.title %>" onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600'">
              <span class="badge bg-primary position-absolute top-0 end-0 m-2"><%= c.category_name || 'Công nghệ' %></span>
            </div>
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-center text-muted small mb-2">
                <span><i class="bi bi-person me-1"></i><%= c.instructor %></span>
                <span class="badge bg-light text-dark border"><%= c.level %></span>
              </div>
              <h5 class="card-title fw-bold text-dark mb-2">
                <a href="/courses/<%= c.id %>" class="text-dark text-decoration-none"><%= c.title %></a>
              </h5>
              <p class="card-text text-muted small flex-grow-1">
                <%= c.description.length > 120 ? c.description.substring(0, 120) + '...' : c.description %>
              </p>
              <div class="border-top pt-3 mt-2 d-flex justify-content-between align-items-center">
                <div class="d-flex gap-3 small text-muted">
                  <span><i class="bi bi-play-circle text-primary me-1"></i> <%= c.total_lessons %> bài</span>
                  <span><i class="bi bi-people text-success me-1"></i> <%= c.total_students %> học viên</span>
                </div>
                <a href="/courses/<%= c.id %>" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
                  Xem chi tiết
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12 text-center py-5">
        <div class="text-muted mb-3"><i class="bi bi-inbox fs-1"></i></div>
        <h5 class="text-muted">Không tìm thấy khóa học nào phù hợp.</h5>
        <a href="/courses" class="btn btn-link text-primary">Xem tất cả khóa học</a>
      </div>
    <% } %>
  </div>
</div>

<%- include('../layouts/footer') %>
