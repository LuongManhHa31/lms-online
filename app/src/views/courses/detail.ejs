<%- include('../layouts/header') %>

<div class="container py-4">
  <!-- Thông báo trạng thái -->
  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
      <i class="bi bi-check-circle-fill me-2 fs-5"></i> <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
      <li class="breadcrumb-item"><a href="/courses">Khóa học</a></li>
      <li class="breadcrumb-item active"><%= course.title %></li>
    </ol>
  </nav>

  <div class="row g-4">
    <!-- Cột chính: Thông tin khóa học & Danh sách bài học -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <span class="badge bg-primary w-auto align-self-start mb-2 px-3 py-2"><%= course.category_name || 'Khóa học tổng hợp' %></span>
        <h2 class="fw-bold text-dark mb-3"><%= course.title %></h2>
        
        <div class="d-flex align-items-center gap-3 text-muted small pb-3 mb-3 border-bottom flex-wrap">
          <div><i class="bi bi-person-circle text-primary me-1"></i> Giảng viên: <strong><%= course.instructor %></strong></div>
          <div><i class="bi bi-bar-chart-fill text-warning me-1"></i> Cấp độ: <strong><%= course.level %></strong></div>
          <div><i class="bi bi-play-circle-fill text-info me-1"></i> <strong><%= lessons.length %></strong> bài học</div>
          <div><i class="bi bi-calendar3 me-1"></i> <%= new Date(course.created_at).toLocaleDateString('vi-VN') %></div>
        </div>

        <h5 class="fw-bold text-dark mb-2">Giới Thiệu Khóa Học</h5>
        <div class="text-secondary mb-4" style="line-height: 1.7; white-space: pre-line;">
          <%= course.description %>
        </div>

        <!-- Danh sách bài học (Curriculum) -->
        <h5 class="fw-bold text-dark mb-3 d-flex justify-content-between align-items-center">
          <span><i class="bi bi-list-check text-primary me-2"></i> Giáo Trình Bài Học (<%= lessons.length %> bài)</span>
          <% if (isEnrolled && lessons.length > 0) { %>
            <span class="badge bg-success-subtle text-success small fw-normal">
              Đã hoàn thành <%= completedLessonIds.length %>/<%= lessons.length %> bài
            </span>
          <% } %>
        </h5>

        <div class="list-group rounded-3 mb-2">
          <% if (lessons.length > 0) { %>
            <% lessons.forEach((lesson, idx) => { %>
              <% const isDone = completedLessonIds.includes(lesson.id); %>
              <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center gap-3">
                  <span class="badge bg-light text-secondary border rounded-circle p-2" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                    <%= lesson.order_num || (idx + 1) %>
                  </span>
                  <div>
                    <h6 class="mb-0 fw-semibold text-dark">
                      <% if (isEnrolled || (currentUser && currentUser.role === 'admin')) { %>
                        <a href="/lessons/<%= lesson.id %>" class="text-dark text-decoration-none hover-primary">
                          <%= lesson.title %>
                        </a>
                      <% } else { %>
                        <span class="text-secondary"><%= lesson.title %></span>
                      <% } %>
                    </h6>
                    <small class="text-muted"><i class="bi bi-clock me-1"></i> <%= lesson.duration_minutes %> phút</small>
                  </div>
                </div>

                <div>
                  <% if (isDone) { %>
                    <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle-fill me-1"></i> Đã học</span>
                  <% } else if (isEnrolled || (currentUser && currentUser.role === 'admin')) { %>
                    <a href="/lessons/<%= lesson.id %>" class="btn btn-outline-primary btn-sm px-3">
                      Học ngay <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                  <% } else { %>
                    <span class="badge bg-light text-muted border"><i class="bi bi-lock-fill me-1"></i> Khóa</span>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="list-group-item text-center text-muted py-4">
              Chưa có bài học nào trong khóa này.
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Cột phụ: Thẻ đăng ký khóa học (Sidebar Card) -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden sticky-top bg-white" style="top: 80px;">
        <img src="<%= course.thumbnail_url %>" class="w-100" style="height: 220px; object-fit: cover;" alt="<%= course.title %>" onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600'">
        <div class="card-body p-4">
          <div class="d-flex align-items-baseline mb-3">
            <span class="h3 fw-bold text-success mb-0">Miễn Phí</span>
            <span class="text-muted text-decoration-line-through ms-2 small">999.000 đ</span>
          </div>

          <!-- Nút hành động chính tùy theo trạng thái tài khoản -->
          <% if (!currentUser) { %>
            <a href="/auth/login" class="btn btn-primary w-100 py-3 fw-bold mb-2 shadow-sm">
              <i class="bi bi-box-arrow-in-right me-2"></i> Đăng Nhập Để Đăng Ký Học
            </a>
            <small class="text-muted text-center d-block">Chưa có tài khoản? <a href="/auth/register">Đăng ký ngay</a></small>
          <% } else if (isEnrolled) { %>
            <div class="alert alert-success text-center py-2 mb-3">
              <i class="bi bi-check-circle-fill me-1"></i> Đã duyệt đăng ký • Đang học
            </div>
            <% if (lessons.length > 0) { %>
              <a href="/lessons/<%= lessons[0].id %>" class="btn btn-success w-100 py-3 fw-bold shadow-sm">
                <i class="bi bi-play-circle-fill me-2"></i> Vào Học Ngay
              </a>
            <% } %>
          <% } else if (enrollmentStatus === 'pending') { %>
            <div class="alert alert-warning text-center py-3 mb-3 border-warning rounded-3 shadow-sm">
              <i class="bi bi-hourglass-split fs-3 text-warning d-block mb-1"></i>
              <div class="fw-bold text-dark">Đang Chờ Quản Trị Viên Xác Nhận</div>
              <p class="small text-muted mb-0 mt-1">
                Yêu cầu đăng ký môn học của bạn đã được tiếp nhận. Bạn sẽ được mở khóa bài học ngay sau khi Quản trị viên phê duyệt.
              </p>
            </div>
            <button class="btn btn-secondary w-100 py-3 fw-semibold mb-2" disabled>
              <i class="bi bi-clock-history me-2"></i> Đang Chờ Xét Duyệt
            </button>
          <% } else if (enrollmentStatus === 'rejected') { %>
            <div class="alert alert-danger text-center py-2 mb-3">
              <i class="bi bi-x-circle-fill me-1"></i> Đơn đăng ký trước đó bị từ chối
            </div>
            <form action="/courses/<%= course.id %>/enroll" method="POST">
              <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-sm mb-2">
                <i class="bi bi-arrow-repeat me-2"></i> Gửi Lại Yêu Cầu Đăng Ký
              </button>
            </form>
          <% } else if (currentUser.role === 'admin') { %>
            <div class="alert alert-info py-2 small mb-3">
              <i class="bi bi-shield-check me-1"></i> Bạn đang xem với vai trò Quản Trị Viên (Admin)
            </div>
            <a href="/admin/courses/<%= course.id %>/lessons" class="btn btn-warning w-100 py-2 fw-bold mb-2 text-dark">
              <i class="bi bi-gear-fill me-1"></i> Quản Lý Bài Học Khóa Này
            </a>
            <% if (lessons.length > 0) { %>
              <a href="/lessons/<%= lessons[0].id %>" class="btn btn-outline-primary w-100 py-2">
                <i class="bi bi-eye me-1"></i> Xem trước bài học
              </a>
            <% } %>
          <% } else { %>
            <!-- Học viên chưa đăng ký -->
            <form action="/courses/<%= course.id %>/enroll" method="POST">
              <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-sm mb-2">
                <i class="bi bi-pencil-square me-2"></i> Đăng Ký Khóa Học Ngay
              </button>
            </form>
            <p class="text-muted text-center small mb-0">Truy cập toàn bộ video và bài học trọn đời</p>
          <% } %>

          <hr class="my-4">
          <h6 class="fw-bold small text-dark mb-3">Khóa học này bao gồm:</h6>
          <ul class="list-unstyled small text-muted d-flex flex-column gap-2 mb-0">
            <li><i class="bi bi-play-btn-fill text-primary me-2"></i> <%= lessons.length %> bài giảng video và tài liệu</li>
            <li><i class="bi bi-infinity text-primary me-2"></i> Truy cập không giới hạn thời gian</li>
            <li><i class="bi bi-phone text-primary me-2"></i> Học tập trên máy tính và điện thoại</li>
            <li><i class="bi bi-award text-primary me-2"></i> Xác nhận hoàn thành khóa học</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
