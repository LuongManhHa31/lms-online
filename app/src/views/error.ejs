<%- include('layouts/header') %>

<div class="container py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-sm border-0 p-4">
        <div class="text-danger mb-3">
          <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem;"></i>
        </div>
        <h1 class="display-5 fw-bold text-dark"><%= typeof statusCode !== 'undefined' ? statusCode : 500 %></h1>
        <h4 class="mb-3"><%= title %></h4>
        <p class="text-muted mb-4"><%= message %></p>
        <div>
          <a href="/" class="btn btn-primary px-4 me-2">
            <i class="bi bi-house me-1"></i> Về Trang Chủ
          </a>
          <button onclick="history.back()" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('layouts/footer') %>
