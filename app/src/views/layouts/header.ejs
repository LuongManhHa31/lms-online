<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'LMS Online - Hệ Thống Đào Tạo Trực Tuyến' %></title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Google Fonts: Be Vietnam Pro (tối ưu hóa hiển thị tiếng Việt sắc nét và chuẩn dấu) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- Header Navigation Bar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm py-2">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="bi bi-mortarboard-fill text-primary fs-3"></i>
      <span class="fw-bold">LMS Online</span>
      <span class="badge brand-badge ms-1">ĐỀ 17</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/' ? 'active fw-bold' : '' %>" href="/">
            <i class="bi bi-house me-1"></i> Trang chủ
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath.startsWith('/courses') ? 'active fw-bold' : '' %>" href="/courses">
            <i class="bi bi-book me-1"></i> Tất cả khóa học
          </a>
        </li>
        <% if (currentUser && currentUser.role === 'student') { %>
          <li class="nav-item">
            <a class="nav-link <%= currentPath.startsWith('/student/my-courses') ? 'active fw-bold' : '' %>" href="/student/my-courses">
              <i class="bi bi-journal-check me-1"></i> Khóa học của tôi
            </a>
          </li>
        <% } %>
        <% if (currentUser && currentUser.role === 'admin') { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-warning <%= currentPath.startsWith('/admin') ? 'active fw-bold' : '' %>" href="#" role="button" data-bs-toggle="dropdown">
              <i class="bi bi-shield-lock-fill me-1"></i> Quản trị hệ thống
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i> Bảng điều khiển (Dashboard)</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/admin/courses"><i class="bi bi-collection me-2"></i> Quản lý Khóa học</a></li>
              <li><a class="dropdown-item" href="/admin/users"><i class="bi bi-people me-2"></i> Quản lý Người dùng & Quyền</a></li>
              <li><a class="dropdown-item" href="/admin/enrollments"><i class="bi bi-card-checklist me-2"></i> Xác Nhận & Quản Lý Đăng Ký</a></li>
            </ul>
          </li>
        <% } %>
      </ul>

      <!-- User Auth Section -->
      <div class="d-flex align-items-center gap-2">
        <% if (currentUser) { %>
          <div class="dropdown">
            <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center gap-2 py-1 px-3" type="button" data-bs-toggle="dropdown">
              <img src="<%= currentUser.avatar %>" alt="avatar" class="rounded-circle" width="28" height="28" style="object-fit: cover;">
              <span class="d-none d-md-inline small"><%= currentUser.full_name %></span>
              <span class="badge <%= currentUser.role === 'admin' ? 'bg-danger' : 'bg-primary' %> small">
                <%= currentUser.role === 'admin' ? 'Admin' : 'Student' %>
              </span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
              <li><h6 class="dropdown-header"><%= currentUser.email %></h6></li>
              <li><a class="dropdown-item" href="/student/profile"><i class="bi bi-person me-2"></i> Hồ sơ của tôi</a></li>
              <% if (currentUser.role === 'student') { %>
                <li><a class="dropdown-item" href="/student/my-courses"><i class="bi bi-journal-bookmark me-2"></i> Khóa học đã đăng ký</a></li>
              <% } %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
            </ul>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn btn-outline-light btn-sm px-3">
            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
          </a>
          <a href="/auth/register" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-person-plus me-1"></i> Đăng ký
          </a>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<main class="py-4">
